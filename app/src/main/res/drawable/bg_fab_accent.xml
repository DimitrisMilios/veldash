<?xml version="1.0" encoding="utf-8"?>
<!-- Recenter: the one button that must be found at a glance, so it gets the yellow ring. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/bat_surface_high" />
            <stroke android:width="3dp" android:color="@color/bat_yellow_dim" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="@color/bat_raised_top" android:endColor="@color/bat_raised_bottom" />
            <stroke android:width="3dp" android:color="@color/bat_yellow" />
        </shape>
    </item>
</selector>
