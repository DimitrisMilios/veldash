<?xml version="1.0" encoding="utf-8"?>
<!--
    Dashboard button slab, by state (the icon and label follow through color/nav_fg):
      pressed   - flat near-black with a yellow outline
      selected  - the yellow accent slab: the one action to find at a glance (RECENTER)
      activated - "lit": the regular slab with a 2dp yellow bar along its top edge (3D on,
                  following on)
      default   - regular gunmetal slab with the pale bevel
    Rounded 8dp like the reference panel; no ripple, so no RenderThread animation per tap.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="@color/gun_edge" />
                </shape>
            </item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="7dp" />
                    <solid android:color="@color/gun_pressed" />
                    <stroke android:width="1dp" android:color="@color/bat_yellow" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Rotary / keyboard focus: the regular slab with a thin yellow inner outline. Without
         this Android paints its own grey focus wash over the button. -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="@color/gun_edge" />
                </shape>
            </item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="7dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="@color/gun_top"
                        android:centerColor="@color/gun_mid"
                        android:endColor="@color/gun_bottom" />
                    <stroke android:width="1dp" android:color="@color/bat_yellow" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="@color/gun_edge" />
                </shape>
            </item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="7dp" />
                    <solid android:color="@color/bat_text" />
                </shape>
            </item>
            <item android:left="1dp" android:top="2dp" android:right="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="7dp" />
                    <gradient android:angle="270" android:startColor="@color/bat_yellow_light" android:endColor="@color/bat_yellow_deep" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_activated="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="@color/gun_edge" />
                </shape>
            </item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="7dp" />
                    <solid android:color="@color/bat_yellow" />
                </shape>
            </item>
            <item android:left="1dp" android:top="3dp" android:right="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="7dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="@color/gun_top"
                        android:centerColor="@color/gun_mid"
                        android:endColor="@color/gun_bottom" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="@color/gun_edge" />
                </shape>
            </item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="7dp" />
                    <solid android:color="@color/gun_highlight" />
                </shape>
            </item>
            <item android:left="1dp" android:top="2dp" android:right="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="7dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="@color/gun_top"
                        android:centerColor="@color/gun_mid"
                        android:endColor="@color/gun_bottom" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
