<?xml version="1.0" encoding="utf-8"?>
<!-- Dark floating card (trip info, empty state), top-lit. Opaque: no blending over the map. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient android:angle="270" android:startColor="@color/bat_raised_top" android:endColor="@color/bat_raised_bottom" />
    <stroke android:width="1dp" android:color="@color/bat_outline" />
</shape>
