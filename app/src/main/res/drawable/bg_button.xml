<?xml version="1.0" encoding="utf-8"?>
<!-- Plain state-list of solid rectangles. No ripple = no RenderThread animation on every tap. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bat_surface_high" />
            <stroke android:width="2dp" android:color="@color/bat_yellow" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bat_surface" />
            <stroke android:width="2dp" android:color="@color/bat_outline" />
        </shape>
    </item>
</selector>
