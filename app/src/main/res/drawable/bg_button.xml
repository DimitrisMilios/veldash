<?xml version="1.0" encoding="utf-8"?>
<!-- Plain rounded button. No ripple = no RenderThread animation on every tap. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/bat_surface_high" />
            <stroke android:width="2dp" android:color="@color/bat_yellow" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:angle="270" android:startColor="@color/bat_raised_top" android:endColor="@color/bat_raised_bottom" />
            <stroke android:width="2dp" android:color="@color/bat_outline" />
        </shape>
    </item>
</selector>
