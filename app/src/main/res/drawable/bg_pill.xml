<?xml version="1.0" encoding="utf-8"?>
<!-- Fully rounded bar (Where to?). A radius above half the height gives pill ends. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="40dp" />
            <solid android:color="@color/bat_surface_high" />
            <stroke android:width="2dp" android:color="@color/bat_yellow" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="40dp" />
            <solid android:color="@color/bat_surface" />
            <stroke android:width="2dp" android:color="@color/bat_outline" />
        </shape>
    </item>
</selector>
