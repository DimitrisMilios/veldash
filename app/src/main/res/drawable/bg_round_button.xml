<?xml version="1.0" encoding="utf-8"?>
<!-- Round glass button (MAPS): same states as the pill. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/ink_glass_pressed" />
            <stroke android:width="1dp" android:color="@color/ink_line" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/ink_glass" />
            <stroke android:width="2dp" android:color="@color/bat_yellow" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/ink_glass" />
            <stroke android:width="1dp" android:color="@color/ink_line" />
        </shape>
    </item>
</selector>
