<?xml version="1.0" encoding="utf-8"?>
<!-- Full-width dashboard bar: black edge, a one-pixel bevel highlight along the top, then the
     top-lit gunmetal slab. Three flat fills, no alpha, no blur: nothing the GPU minds. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/gun_edge" />
        </shape>
    </item>
    <item android:top="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/gun_highlight" />
        </shape>
    </item>
    <item android:top="2dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/gun_top"
                android:centerColor="@color/gun_mid"
                android:endColor="@color/gun_bottom" />
        </shape>
    </item>
</layer-list>
