<?xml version="1.0" encoding="utf-8"?>
<!-- Icon and label colour of a dashboard button, by the button's state (see bg_nav_button):
     pressed = yellow on the dark pressed slab, selected = black on the yellow accent slab,
     activated ("lit": a feature that is on) = yellow, otherwise pale steel. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:color="@color/bat_yellow" />
    <item android:state_selected="true" android:color="@color/bat_black" />
    <item android:state_activated="true" android:color="@color/bat_yellow" />
    <item android:color="@color/gun_text" />
</selector>
