<?xml version="1.0" encoding="utf-8"?>
<!-- Glyph colour of a round button by state: black on the solid yellow call to action
     (selected), yellow when the feature is on (activated), white while pressed, pale otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:color="@color/bat_black" />
    <item android:state_activated="true" android:color="@color/bat_yellow" />
    <item android:state_pressed="true" android:color="@color/bat_text" />
    <item android:color="@color/icon_idle" />
</selector>
