<?xml version="1.0" encoding="utf-8"?>
<!-- Place editor (Home, Work, favorites): name (favorites only), address, then the logo chips.
     The chips are added in code (PlaceEditor); the status line reports geocoding progress. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/gap_xl"
    android:paddingEnd="@dimen/gap_xl"
    android:paddingTop="@dimen/gap_large"
    android:paddingBottom="@dimen/gap">

    <EditText
        android:id="@+id/edit_place_name"
        android:layout_width="match_parent"
        android:layout_height="@dimen/field_height"
        android:background="@drawable/bg_well"
        android:fontFamily="sans-serif"
        android:hint="@string/place_name_hint"
        android:imeOptions="actionNext|flagNoExtractUi"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:selectAllOnFocus="true"
        android:paddingStart="@dimen/gap_large"
        android:paddingEnd="@dimen/gap_large"
        android:singleLine="true"
        android:textColor="@color/bat_text"
        android:textColorHint="@color/text_label"
        android:textCursorDrawable="@null"
        android:textSize="@dimen/text_body" />

    <EditText
        android:id="@+id/edit_place_address"
        android:layout_width="match_parent"
        android:layout_height="@dimen/field_height"
        android:layout_marginTop="@dimen/gap_medium"
        android:background="@drawable/bg_well"
        android:fontFamily="sans-serif"
        android:hint="@string/place_address_hint"
        android:imeOptions="actionDone|flagNoExtractUi"
        android:importantForAutofill="no"
        android:inputType="textPostalAddress"
        android:paddingStart="@dimen/gap_large"
        android:paddingEnd="@dimen/gap_large"
        android:singleLine="true"
        android:textColor="@color/bat_text"
        android:textColorHint="@color/text_label"
        android:textCursorDrawable="@null"
        android:textSize="@dimen/text_body" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap"
        android:layout_marginTop="@dimen/gap_large"
        android:text="@string/choose_icon"
        style="@style/Widget.Veldash.Label" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/row_place_icons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/txt_place_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap"
        android:layout_marginTop="@dimen/gap_medium"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:textColor="@color/bat_text_dim"
        android:textSize="@dimen/text_row_subtitle"
        android:visibility="gone" />
</LinearLayout>
