<?xml version="1.0" encoding="utf-8"?>
<!-- One search-dropdown row: round icon chip, title over a grey subtitle, optional trailing
     action ("Edit" on Home / Work). Bound in SearchPanel. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_row"
    android:gravity="center_vertical"
    android:minHeight="@dimen/row_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/gap"
    android:paddingEnd="4dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/row_icon"
        android:layout_width="@dimen/chip"
        android:layout_height="@dimen/chip"
        android:background="@drawable/bg_chip"
        android:contentDescription="@null"
        android:padding="@dimen/row_icon_padding"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap_large"
        android:layout_marginEnd="@dimen/gap"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/bat_text"
            android:textSize="@dimen/text_row_title" />

        <TextView
            android:id="@+id/row_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/text_label"
            android:textSize="@dimen/text_row_subtitle" />
    </LinearLayout>

    <TextView
        android:id="@+id/row_action"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/icon_button"
        android:background="@drawable/bg_row"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:minWidth="@dimen/icon_button"
        android:paddingStart="@dimen/gap_medium"
        android:paddingEnd="@dimen/gap_medium"
        android:text="@string/edit"
        android:textColor="@color/bat_yellow"
        android:textSize="@dimen/text_row_subtitle"
        android:visibility="gone" />
</LinearLayout>
