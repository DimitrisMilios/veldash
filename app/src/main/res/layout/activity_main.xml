<?xml version="1.0" encoding="utf-8"?>
<!--
    Single-level hierarchy. The MapView (a SurfaceView) is added programmatically at index 0
    so every overlay below is composited above it. No nested layouts, no weights: the HUD is
    a flat set of gravity-positioned views over one opaque black strip.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/map_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bat_black">

    <TextView
        android:id="@+id/txt_status"
        style="@style/Widget.Veldash.Hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@null"
        android:gravity="center"
        android:padding="@dimen/gap_large"
        android:text="@string/no_map_loaded"
        android:textSize="@dimen/text_body" />

    <!-- ===== Top HUD strip (visible while navigating) ===== -->

    <View
        android:id="@+id/hud_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hud_height"
        android:layout_gravity="top"
        android:background="@color/bat_black"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/img_maneuver"
        android:layout_width="@dimen/hud_icon"
        android:layout_height="@dimen/hud_icon"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/gap"
        android:layout_marginTop="@dimen/gap"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_turn_straight"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txt_turn_distance"
        style="@style/Widget.Veldash.Hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/hud_text_start"
        android:layout_marginTop="2dp"
        android:background="@null"
        android:textSize="@dimen/text_turn"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txt_turn_street"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/hud_text_start"
        android:layout_marginTop="@dimen/hud_street_top"
        android:layout_marginEnd="@dimen/hud_speed_reserve"
        android:ellipsize="end"
        android:fontFamily="sans-serif-condensed"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textColor="@color/bat_text_dim"
        android:textSize="@dimen/text_body"
        android:visibility="gone" />

    <!-- Speed readout, always visible. Opaque black background: one solid quad, no blending. -->
    <TextView
        android:id="@+id/txt_speed"
        style="@style/Widget.Veldash.Hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/gap"
        android:gravity="center"
        android:minWidth="120dp"
        android:paddingStart="@dimen/gap_large"
        android:paddingEnd="@dimen/gap_large"
        android:paddingTop="@dimen/gap"
        android:paddingBottom="@dimen/gap"
        android:text="@string/gps_searching"
        android:textSize="@dimen/text_speed" />

    <!-- ===== Bottom ===== -->

    <!-- Remaining distance / ETA while navigating; routing status otherwise. -->
    <TextView
        android:id="@+id/txt_route"
        style="@style/Widget.Veldash.Hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/gap_large"
        android:gravity="center"
        android:paddingStart="@dimen/gap_large"
        android:paddingEnd="@dimen/gap_large"
        android:paddingTop="@dimen/gap"
        android:paddingBottom="@dimen/gap"
        android:textSize="@dimen/text_body"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_search"
        style="@style/Widget.Veldash.Button"
        android:layout_width="@dimen/btn_search_width"
        android:layout_height="@dimen/touch_target"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/gap"
        android:layout_marginBottom="@dimen/gap_large"
        android:text="@string/where_to" />

    <Button
        android:id="@+id/btn_load_map"
        style="@style/Widget.Veldash.Button"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_target"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/btn_load_map_start"
        android:layout_marginBottom="@dimen/gap_large"
        android:paddingStart="@dimen/gap_large"
        android:paddingEnd="@dimen/gap_large"
        android:text="@string/load_map" />

    <!-- Shown only while follow mode is off (driver panned the map). -->
    <ImageButton
        android:id="@+id/btn_recenter"
        android:layout_width="@dimen/touch_target_large"
        android:layout_height="@dimen/touch_target_large"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/gap_large"
        android:background="@drawable/bg_button"
        android:contentDescription="@string/recenter"
        android:padding="@dimen/gap_large"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_batmobile"
        android:visibility="gone" />

    <!-- ===== Search panel: GONE until opened, covers everything while open ===== -->
    <LinearLayout
        android:id="@+id/panel_search"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bat_black"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:layout_margin="@dimen/gap"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edit_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_button"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingStart="@dimen/gap_large"
                android:paddingEnd="@dimen/gap_large"
                android:singleLine="true"
                android:textColor="@color/bat_text"
                android:textColorHint="@color/bat_text_dim"
                android:textSize="@dimen/text_body" />

            <Button
                android:id="@+id/btn_search_go"
                style="@style/Widget.Veldash.Button"
                android:layout_width="@dimen/touch_target_large"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/gap"
                android:text="@string/search" />

            <Button
                android:id="@+id/btn_search_close"
                style="@style/Widget.Veldash.Button"
                android:layout_width="@dimen/touch_target"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/gap"
                android:text="@string/close" />
        </LinearLayout>

        <ListView
            android:id="@+id/list_places"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:cacheColorHint="@color/bat_black"
            android:divider="@color/bat_outline"
            android:dividerHeight="1dp"
            android:scrollbars="none" />
    </LinearLayout>

    <!-- OSM attribution is a licence requirement for OpenStreetMap-derived tiles. -->
    <TextView
        android:id="@+id/txt_attribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:padding="2dp"
        android:text="@string/attribution_osm"
        android:textColor="@color/bat_text_dim"
        android:textSize="10sp" />

</FrameLayout>
