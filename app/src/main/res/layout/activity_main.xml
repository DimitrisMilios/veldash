<?xml version="1.0" encoding="utf-8"?>
<!--
    The MapView (a SurfaceView) is added programmatically at index 0 so every overlay below is
    composited above it. Overlays are a handful of opaque floating cards and round buttons,
    each at most two levels deep: nothing here is measured more than once per change.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/map_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bat_black">

    <!-- Batmobile as a screen overlay while the camera follows: the camera's target point is a
         fixed screen position, so drawing the car here is jitter-free (a map-layer marker lags
         the camera by a frame). One view per render (overhead 2D, rear chase 3D) so a view
         switch can cross-fade them. Bitmaps and position set in code; hidden when panned. -->
    <ImageView
        android:id="@+id/img_car_2d"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:contentDescription="@null"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/img_car_3d"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:contentDescription="@null"
        android:visibility="gone" />

    <!-- ===== Empty state: shown until a map is loaded ===== -->
    <LinearLayout
        android:id="@+id/panel_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/gap_xl"
        android:paddingEnd="@dimen/gap_xl"
        android:paddingTop="@dimen/gap_xl"
        android:paddingBottom="@dimen/gap_xl">

        <ImageView
            android:layout_width="@dimen/empty_logo_width"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:src="@drawable/bat_logo" />

        <TextView
            android:id="@+id/txt_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_large"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:text="@string/no_map_loaded"
            android:textColor="@color/bat_text"
            android:textSize="@dimen/text_body" />

        <Button
            android:id="@+id/btn_empty_load_map"
            style="@style/Widget.Veldash.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:layout_marginTop="@dimen/gap_large"
            android:minWidth="@dimen/btn_primary_min_width"
            android:text="@string/load_map"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ===== Next-turn card (top-left, while navigating) ===== -->
    <LinearLayout
        android:id="@+id/card_maneuver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/gap_large"
        android:layout_marginTop="@dimen/gap_large"
        android:layout_marginEnd="@dimen/hud_speed_reserve"
        android:background="@drawable/bg_card_maneuver"
        android:gravity="center_vertical"
        android:minWidth="@dimen/card_maneuver_min_width"
        android:orientation="horizontal"
        android:paddingStart="@dimen/gap_large"
        android:paddingEnd="@dimen/gap_xl"
        android:paddingTop="@dimen/gap_medium"
        android:paddingBottom="@dimen/gap_medium"
        android:visibility="gone">

        <!-- Turn arrows are yellow vectors: tinted black on the yellow card (the logo is not). -->
        <ImageView
            android:id="@+id/img_maneuver"
            android:layout_width="@dimen/hud_icon"
            android:layout_height="@dimen/hud_icon"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_turn_straight"
            android:tint="@color/bat_black" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_medium"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_turn_distance"
                style="@style/Widget.Veldash.CardText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_turn"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_turn_street"
                style="@style/Widget.Veldash.CardText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textSize="@dimen/text_body" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Speed badge (top-right, always visible) ===== -->
    <LinearLayout
        android:id="@+id/speed_badge"
        android:layout_width="@dimen/speed_badge"
        android:layout_height="@dimen/speed_badge"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/gap_large"
        android:background="@drawable/bg_speed"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_speed"
            style="@style/Widget.Veldash.Hud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gps_searching"
            android:textColor="@color/bat_text_dim"
            android:textSize="@dimen/text_speed"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_speed_unit"
            style="@style/Widget.Veldash.Hud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/speed_unit"
            android:textColor="@color/bat_text_dim"
            android:textSize="@dimen/text_caption"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ===== Top-left search bar (idle). While a route is up the next-turn card takes this spot. ===== -->
    <Button
        android:id="@+id/btn_search"
        style="@style/Widget.Veldash.Button"
        android:layout_width="@dimen/search_width"
        android:layout_height="@dimen/touch_target"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/gap_large"
        android:layout_marginTop="@dimen/gap_large"
        android:layout_marginEnd="@dimen/hud_speed_reserve"
        android:background="@drawable/bg_pill"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="@dimen/gap_medium"
        android:gravity="start|center_vertical"
        android:paddingStart="@dimen/gap_xl"
        android:paddingEnd="@dimen/gap_xl"
        android:text="@string/where_to"
        android:textColor="@color/bat_text_dim" />

    <!-- ===== Bottom-left trip card (routing / navigating) ===== -->
    <LinearLayout
        android:id="@+id/card_trip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/gap_large"
        android:layout_marginEnd="@dimen/actions_reserve"
        android:layout_marginBottom="@dimen/bottom_margin"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:minWidth="@dimen/card_trip_min_width"
        android:orientation="horizontal"
        android:paddingStart="@dimen/gap_xl"
        android:paddingEnd="@dimen/gap_medium"
        android:paddingTop="@dimen/gap_medium"
        android:paddingBottom="@dimen/gap_medium"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/gap_large"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_trip_main"
                style="@style/Widget.Veldash.Hud"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null"
                android:ellipsize="end"
                android:singleLine="true"
                android:textSize="@dimen/text_trip"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_trip_sub"
                style="@style/Widget.Veldash.Hud"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@null"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/bat_text_dim"
                android:textSize="@dimen/text_caption_large" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_end_route"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="@drawable/bg_fab_danger"
            android:contentDescription="@string/end_route"
            android:padding="@dimen/gap_large"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            android:tint="@color/bat_text" />
    </LinearLayout>

    <!-- ===== Bottom-right: round map actions. Recenter appears only after the driver pans. ===== -->
    <LinearLayout
        android:id="@+id/col_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/gap_large"
        android:layout_marginBottom="@dimen/bottom_margin"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/btn_load_map"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="@drawable/bg_fab"
            android:contentDescription="@string/load_map"
            android:padding="@dimen/gap_large"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_layers" />

        <!-- 3D chase view / 2D top-down toggle. -->
        <Button
            android:id="@+id/btn_view_mode"
            style="@style/Widget.Veldash.Button"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:layout_marginTop="@dimen/gap_medium"
            android:background="@drawable/bg_fab"
            android:padding="0dp"
            android:text="@string/view_3d"
            android:textStyle="bold" />

        <!-- Bitmap (the 2D batmobile) set in code. -->
        <ImageButton
            android:id="@+id/btn_recenter"
            android:layout_width="@dimen/touch_target_large"
            android:layout_height="@dimen/touch_target_large"
            android:layout_marginTop="@dimen/gap_medium"
            android:background="@drawable/bg_fab_accent"
            android:contentDescription="@string/recenter"
            android:padding="@dimen/gap_medium"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </LinearLayout>

    <!-- OSM attribution is a licence requirement for OpenStreetMap-derived tiles.
         Below the search panel: that covers the map, so the credit goes with it. -->
    <TextView
        android:id="@+id/txt_attribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/gap_large"
        android:padding="2dp"
        android:text="@string/attribution_osm"
        android:textColor="@color/bat_text_dim"
        android:textSize="10sp" />

    <!-- ===== Search dropdown (Google Maps style): GONE until opened =====
         A scrim dims the map and closes the dropdown on tap; the card sits where the search
         bar was and grows down: field, then Home / Work / saved / recent rows or results. -->
    <View
        android:id="@+id/scrim_search"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bat_scrim"
        android:clickable="true"
        android:contentDescription="@string/close"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/panel_search"
        android:layout_width="@dimen/search_panel_width"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/gap_large"
        android:layout_marginTop="@dimen/gap_large"
        android:layout_marginBottom="@dimen/gap_large"
        android:background="@drawable/bg_search_card"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/gap"
            android:paddingEnd="@dimen/gap">

            <ImageButton
                android:id="@+id/btn_search_close"
                android:layout_width="@dimen/icon_button"
                android:layout_height="@dimen/icon_button"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/close"
                android:padding="@dimen/gap_large"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back" />

            <EditText
                android:id="@+id/edit_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/gap"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="@color/bat_text"
                android:textColorHint="@color/bat_text_dim"
                android:textCursorDrawable="@null"
                android:textSize="@dimen/text_body" />

            <ImageButton
                android:id="@+id/btn_search_go"
                android:layout_width="@dimen/icon_button"
                android:layout_height="@dimen/icon_button"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/search"
                android:padding="@dimen/gap_large"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_search" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/bat_outline" />

        <!-- A dozen rows at most: a plain LinearLayout (rows recycled by index in code) wraps its
             content, which a ListView cannot; the ScrollView only scrolls when it hits the bottom. -->
        <ScrollView
            android:id="@+id/scroll_places"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/list_places"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/gap"
                android:paddingBottom="@dimen/gap" />
        </ScrollView>
    </LinearLayout>

</FrameLayout>
