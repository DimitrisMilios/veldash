<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- In-car touch targets: 64dp minimum, glove-friendly. -->
    <dimen name="touch_target">64dp</dimen>
    <dimen name="gap">8dp</dimen>
    <dimen name="gap_medium">12dp</dimen>
    <dimen name="gap_large">16dp</dimen>
    <dimen name="gap_xl">24dp</dimen>

    <!-- Dashboard bars: banner on top, trip readouts and the action row at the bottom.
