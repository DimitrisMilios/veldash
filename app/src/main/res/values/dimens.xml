    <dimen name="row_height">72dp</dimen>
    <dimen name="row_icon">44dp</dimen>
    <dimen name="row_icon_padding">10dp</dimen>
    <dimen name="row_logo_padding">4dp</dimen>
    <dimen name="text_row_title">20sp</dimen>
