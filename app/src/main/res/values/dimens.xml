    <dimen name="bar_top">64dp</dimen>
    <dimen name="bar_status">48dp</dimen>
    <dimen name="bar_nav">72dp</dimen>
    <!-- Buttons inside the top banner. -->
    <dimen name="bar_button">52dp</dimen>
    <dimen name="bar_button_wide">72dp</dimen>
    <dimen name="bar_icon">26dp</dimen>
    <dimen name="bar_icon_small">20dp</dimen>
    <dimen name="bar_emblem">34dp</dimen>
    <!-- Gap between the action-row buttons and around them. -->
    <dimen name="gap_nav">5dp</dimen>
    <dimen name="nav_icon">30dp</dimen>
    <!-- The batmobile render on its button: bigger than the glyphs so it reads as the car. -->
    <dimen name="nav_icon_car_w">64dp</dimen>
    <dimen name="nav_icon_car_h">40dp</dimen>

    <!-- Typography: condensed bold capitals, readable at arm's length. -->
    <dimen name="text_bar">20sp</dimen>
