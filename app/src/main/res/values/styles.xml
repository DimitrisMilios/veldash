<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Platform theme only: no AppCompat, no Material Components library.
        android:Theme.Material.NoActionBar exists on every API >= 21 device and costs zero DEX.
    -->
    <style name="Base.Theme.Veldash" parent="android:Theme.Material.NoActionBar">
        <!-- Solid color window background (not a drawable): one GL clear, no extra overdraw layer. -->
        <item name="android:windowBackground">@color/bat_black</item>
        <item name="android:colorBackground">@color/bat_black</item>
        <item name="android:colorPrimary">@color/bat_black</item>
        <item name="android:colorPrimaryDark">@color/bat_black</item>
        <item name="android:colorAccent">@color/bat_yellow</item>
        <item name="android:statusBarColor">@color/bat_black</item>
        <item name="android:navigationBarColor">@color/bat_black</item>

        <item name="android:textColorPrimary">@color/bat_text</item>
        <item name="android:textColorSecondary">@color/bat_text_dim</item>

        <!-- Full screen, no title, no content-overlay shadow. -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>

        <!-- Kill every window/activity transition: no cross-fades, no scale animations. -->
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowActivityTransitions">false</item>
        <item name="android:windowContentTransitions">false</item>

        <!-- Keep the launch preview window: it is cheap and makes cold start feel instant. -->
        <item name="android:windowDisablePreview">false</item>

        <!-- Flat everything. -->
        <item name="android:windowElevation">0dp</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>

    <!-- values-v31 adds the Android 12+ splash screen colours on top of the base. -->
    <style name="Theme.Veldash" parent="Base.Theme.Veldash" />

    <!-- Type scale, all system Roboto (no font files):
         Label = tiny tracked capitals in grey (ARRIVAL, SPEED, the maneuver),
         Value = Roboto Medium numerals in white, Body = regular copy. -->
    <style name="Widget.Veldash.Label" parent="">
        <item name="android:textColor">@color/text_label</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Widget.Veldash.Value" parent="">
        <item name="android:textColor">@color/bat_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_value</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Widget.Veldash.Body" parent="">
        <item name="android:textColor">@color/bat_text</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Big round map button (3D / 2D, recenter): 64dp glass disc. The glyph inside mirrors
         the button state (duplicateParentState) and recolours through color/fab_fg. -->
    <style name="Widget.Veldash.Fab" parent="">
        <item name="android:layout_width">@dimen/fab</item>
        <item name="android:layout_height">@dimen/fab</item>
        <item name="android:background">@drawable/bg_round_fab</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- The one primary action on a screen: a yellow pill with black text. Flat, no ripple. -->
    <style name="Widget.Veldash.Button" parent="android:Widget.Material.Button.Borderless">
        <item name="android:minHeight">@dimen/btn_primary_height</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/bat_black</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:paddingStart">@dimen/gap_xl</item>
        <item name="android:paddingEnd">@dimen/gap_xl</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="Widget.Veldash.Button.Primary" />
</resources>
