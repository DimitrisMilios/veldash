<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Platform theme only: no AppCompat, no Material Components library.
        android:Theme.Material.NoActionBar exists on every API >= 21 device and costs zero DEX.
    -->
    <style name="Base.Theme.Veldash" parent="android:Theme.Material.NoActionBar">
        <!-- Solid color window background (not a drawable): one GL clear, no extra overdraw layer. -->
        <item name="android:windowBackground">@color/bat_black</item>
        <item name="android:colorBackground">@color/bat_black</item>
        <item name="android:colorPrimary">@color/bat_black</item>
        <item name="android:colorPrimaryDark">@color/bat_black</item>
        <item name="android:colorAccent">@color/bat_yellow</item>
        <item name="android:statusBarColor">@color/bat_black</item>
        <item name="android:navigationBarColor">@color/bat_black</item>

        <item name="android:textColorPrimary">@color/bat_text</item>
        <item name="android:textColorSecondary">@color/bat_text_dim</item>

        <!-- Full screen, no title, no content-overlay shadow. -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>

        <!-- Kill every window/activity transition: no cross-fades, no scale animations. -->
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowActivityTransitions">false</item>
        <item name="android:windowContentTransitions">false</item>

        <!-- Keep the launch preview window: it is cheap and makes cold start feel instant. -->
        <item name="android:windowDisablePreview">false</item>

        <!-- Flat everything. -->
        <item name="android:windowElevation">0dp</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>

    <!-- values-v31 adds the Android 12+ splash screen colours on top of the base. -->
    <style name="Theme.Veldash" parent="Base.Theme.Veldash" />

    <!-- Dashboard lettering: condensed bold capitals, slightly tracked, like an engraved
         instrument panel. Label = yellow (ETA:, TO:), Value = white (the reading). -->
    <style name="Widget.Veldash.Label" parent="">
        <item name="android:textColor">@color/bat_yellow</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Widget.Veldash.Value" parent="Widget.Veldash.Label">
        <item name="android:textColor">@color/bat_text</item>
    </style>

    <!-- Action-row buttons: a bevelled slab holding an icon over a label. The children mirror
         the slab's state (duplicateParentState) so pressed / lit / accent recolour them through
         the nav_fg colour list, with no code. -->
    <style name="Widget.Veldash.NavButton" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">@dimen/gap_nav</item>
        <item name="android:layout_marginEnd">@dimen/gap_nav</item>
        <item name="android:background">@drawable/bg_nav_button</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Widget.Veldash.NavIcon" parent="">
        <item name="android:layout_width">@dimen/nav_icon</item>
        <item name="android:layout_height">@dimen/nav_icon</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/nav_fg</item>
        <item name="android:duplicateParentState">true</item>
    </style>

    <style name="Widget.Veldash.NavLabel" parent="Widget.Veldash.Label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/nav_fg</item>
        <item name="android:textSize">@dimen/text_nav_label</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- Plain button base. Flat, no state-list animators, no ripples. -->
    <style name="Widget.Veldash.Button" parent="android:Widget.Material.Button.Borderless">
        <item name="android:minWidth">@dimen/touch_target</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:background">@drawable/bg_nav_button</item>
        <item name="android:textColor">@color/nav_fg</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- Solid yellow slab, black text: the one primary action on a screen. -->
    <style name="Widget.Veldash.Button.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/bat_black</item>
        <item name="android:paddingStart">@dimen/gap_xl</item>
        <item name="android:paddingEnd">@dimen/gap_xl</item>
    </style>
</resources>
