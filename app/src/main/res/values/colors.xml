<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base palette: near-black ink, bat-signal yellow, white type. High contrast for sunlight. -->
    <color name="bat_black">#000000</color>
    <color name="bat_yellow">#FFE600</color>
    <color name="bat_yellow_pressed">#D9C300</color>
    <!-- The lane not taken in the keep-left / keep-right arrows. -->
    <color name="bat_yellow_dim">#B3A100</color>
    <color name="bat_text">#FFFFFF</color>
    <color name="bat_text_dim">#9AA0A8</color>
    <!-- Dims the map behind the open search dropdown. -->
    <color name="bat_scrim">#99000000</color>

    <!-- Floating islands over the map: 90% ink glass with a hairline of 12% white. Flat, no
         gradients, no bevels. The dropdown is a little denser so its rows read cleanly. -->
    <color name="ink">#0F1115</color>
    <color name="ink_glass">#E60F1115</color>
    <color name="ink_glass_pressed">#E6232730</color>
    <color name="ink_glass_deep">#F50B0D10</color>
    <color name="ink_line">#1FFFFFFF</color>
    <!-- Wells and chips inside an island: 8% white, 16% when pressed. -->
    <color name="ink_fill">#14FFFFFF</color>
    <color name="ink_fill_hi">#29FFFFFF</color>
    <!-- Small tracked labels (ARRIVAL, SPEED), secondary copy, idle button glyphs. -->
    <color name="text_label">#8B9099</color>
    <color name="text_secondary">#C3C7CE</color>
    <color name="icon_idle">#C9CDD3</color>

    <!-- Map overlay colors (route line, casing). -->
    <color name="route_line">#FFE600</color>
    <color name="route_casing">#000000</color>
    <color name="route_traversed">#5C5400</color>
</resources>
